datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model Usuario {
  id            String    @id @default(uuid())
  name          String?   @map("nombre") // <--- MAPEADO A LA COLUMNA FÍSICA 'nombre'
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   // Opcional para login con Google
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  archivos      Archivo[]
  accounts      Account[]
  sessions      Session[]

  @@map("usuarios")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  usuario      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Archivo {
  id        String   @id @default(uuid())
  titulo    String
  path      String
  contenido String?
  mimeType  String
  tamano    Int
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())

  @@map("archivos")
}

model Oracion {
  id        String   @id @default(uuid())
  nombre    String   @default("Anónimo")
  request   String
  isPrivate Boolean  @default(false)
  status    String   @default("En Oración")
  createdAt DateTime @default(now())

  @@map("oraciones")
}

model Testimonio {
  id        String   @id @default(cuid())
  autor     String
  titulo    String
  contenido String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonios")
}

model SolicitudCurso {
  id        String   @id @default(uuid())
  curso     String
  nombre    String
  telefono  String
  direccion String?
  modalidad String
  createdAt DateTime @default(now())

  @@map("solicitudes_cursos")
}
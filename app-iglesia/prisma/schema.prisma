// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  password  String
  rol       String   @default("USER") // <--- Agregar esta línea si falta
  createdAt DateTime @default(now())
  archivos  Archivo[]
}

model Archivo {
  id        String   @id @default(uuid())
  nombre    String
  path      String
  mimeType  String
  tamano    Int
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
}

model Oracion {
  id        String   @id @default(uuid())
  nombre    String   @default("Anónimo")
  request   String
  isPrivate Boolean  @default(false)
  status    String   @default("En Oración")
  createdAt DateTime @default(now())
}

model Testimonio {
  id        String   @id @default(uuid())
  author    String
  title     String
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model SolicitudCurso {
  id        String   @id @default(uuid())
  curso     String
  nombre    String
  telefono  String
  direccion String?
  modalidad String
  createdAt DateTime @default(now())
}